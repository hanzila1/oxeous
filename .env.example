# =============================================================================
# OXEOUS — Environment Variables
# Stack: Gemini (LLM) + Google Earth Engine (satellite data)
# =============================================================================

# ── LLM: Google Gemini (PRIMARY — required for explanations) ──────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GRANITE_DEPLOYMENT=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Google Earth Engine (PRIMARY — required for satellite analysis) ────────────
# Setup: earthengine authenticate  (one-time, uses Google account)
# Your GEE project (must have Earth Engine enabled):
GEE_PROJECT=ee-hanzilabinyounasai

# ── NASA EarthData (OPTIONAL — enables NDVI change via HLS S30) ───────────────
# Register free at: https://urs.earthdata.nasa.gov/
# Without this token, NDVI check is gracefully skipped (GEE handles deforestation)
NASA_EARTHDATA_TOKEN=

# ── App Settings ──────────────────────────────────────────────────────────────
MAX_AOI_DEG2=4.0
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
TILE_CACHE_DIR=/tmp/oxeous_tiles

# ── Legacy / Optional (not needed for EUDR pipeline) ─────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL=granite3-8b
GRANITE_OLLAMA_URL=http://localhost:11434
WDPA_API_KEY=
GFW_API_KEY=
REDIS_URL=redis://localhost:6379/0
